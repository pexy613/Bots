DISCORD_TOKEN=your-bot-token-here

# Optional: set this to your server's ID while developing so slash commands
# sync instantly to that guild instead of taking up to an hour globally.
DEV_GUILD_ID=

# Optional: mirrors sales/settings/goals into Supabase's gun_bot schema.
# Leave both blank to run with local SQLite only.
# SUPABASE_SERVICE_ROLE_KEY is the *secret* service_role key from
# Project Settings > API — never the anon/publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
