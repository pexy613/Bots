DISCORD_TOKEN=your-bot-token-here

# Optional: set this to your server's ID while developing so slash commands
# sync instantly to that guild instead of taking up to an hour globally.
DEV_GUILD_ID=

# Required: mirrors sales/settings/goals into Supabase's gun_bot schema.
# Same project/key as GangBot's wash logger and RecruitBot — see the repo
# root's .env.template. The bot will fail to start without these.
SUPABASE_URL=
SUPABASE_KEY=
